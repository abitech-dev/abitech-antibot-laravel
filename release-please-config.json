{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "php",
  "include-v-in-tag": false,
  "pull-request-title-pattern": "chore(release): publicar la versión ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Agregado" },
    { "type": "fix", "section": "Corregido" },
    { "type": "perf", "section": "Rendimiento" },
    { "type": "refactor", "section": "Cambiado", "hidden": true },
    { "type": "docs", "section": "Documentación", "hidden": true },
    { "type": "test", "section": "Pruebas", "hidden": true },
    { "type": "build", "section": "Dependencias", "hidden": true },
    { "type": "ci", "section": "Integración continua", "hidden": true },
    { "type": "chore", "section": "Mantenimiento", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "abitechdev/antibot-laravel",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
